{
  "name": "dsh-plugin-socket",
  "version": "0.1.0",
  "description": "Plugin socket for DSH: one slot per plugin, capability-based sandbox, conflict detection, JSON-over-TCP IPC. 让 DSH 插件互不打架。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "plugin-manager",
    "sandbox",
    "ipc",
    "capability"
  ],
  "license": "MIT",
  "type": "commonjs",
  "main": "index.js",
  "bin": {
    "dsh-plugin": "bin/dsh-plugin.js"
  },
  "files": [
    "bin",
    "lib",
    "index.js",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/run.js",
    "demo": "node bin/dsh-plugin.js --home ./.demo-home install demo && node bin/dsh-plugin.js --home ./.demo-home list"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR_NAME/dsh-plugin-socket.git"
  },
  "bugs": {
    "url": "https://github.com/YOUR_NAME/dsh-plugin-socket/issues"
  },
  "homepage": "https://github.com/YOUR_NAME/dsh-plugin-socket#readme",
  "author": "YG",
  "os": [
    "win32",
    "linux",
    "darwin"
  ]
}
